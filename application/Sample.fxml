<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="545.0" prefWidth="555.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.Controller">
    <children>
        <VBox alignment="CENTER" layoutX="84.0" layoutY="131.0" prefHeight="256.0" prefWidth="404.0" spacing="10.0">
            <Label text="Regjistrohu" />
            <TextField fx:id="firstNameField" promptText="Emri" />
            <TextField fx:id="lastNameField" promptText="Mbiemri" />
            <TextField fx:id="emailField" promptText="Email" />
            <TextField fx:id="phoneField" promptText="Telefoni" />
            <TextField fx:id="genderField" promptText="Gjinia" />
            <Button fx:id="continueButton" onAction="#continueClicked" text="Vazhdo" />
        </VBox>
    </children>
</AnchorPane>
